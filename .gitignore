# Local working notes — not shipped
docs/

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/

# Env / secrets
# The glob, not a bare `.env`: an editor's `.env.save`, a `.env.local`, or a hand-made
# `.env.bak` carries the same API key and would otherwise be committable.
.env*
!.env.example

# Your filled-in configuration. filters.yaml holds your salary floor and profile.yaml holds
# your competencies — personal decisions, not something to publish. The .example files are
# the templates and stay tracked.
src/candidate/filters.yaml
src/candidate/profile.yaml

# OS / editor
.DS_Store
.idea/
# `.vscode/*`, not `.vscode/`: git refuses to re-include a file whose parent directory is
# excluded, so a trailing-slash pattern would make the exception below silently dead.
.vscode/*
# The one exception: formatter settings are a project decision, not a machine preference —
# an editor wrapping at a different width than ruff breaks CI on every commit.
!.vscode/settings.json
