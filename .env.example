# Copy to .env and fill in real values. Never commit .env.
CONTACT_EMAIL=you@example.com

# Postgres — also read directly by docker-compose.yml to configure the postgres service.
POSTGRES_USER=job_agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=job_agent

# Both hosts name docker-compose services. Running from your shell against the same
# containers means `localhost` in both — the ports are published on 127.0.0.1.
DATABASE_URL=postgresql://job_agent:change-me@postgres:5432/job_agent
OLLAMA_HOST=http://ollama:11434

# Any Ollama embedding model returning 768 dimensions, to match migrations/001_init.sql.
OLLAMA_EMBED_MODEL=nomic-embed-text
ANTHROPIC_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
