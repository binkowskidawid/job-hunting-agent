# Copy to .env and fill in real values. Never commit .env.
CONTACT_EMAIL=you@example.com

# Postgres — also read directly by docker-compose.yml to configure the postgres service.
POSTGRES_USER=job_agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=job_agent

DATABASE_URL=postgresql://job_agent:change-me@postgres:5432/job_agent
OLLAMA_HOST=http://ollama:11434
ANTHROPIC_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
